#!/usr/bin/env bash

if [ "$SUPERVISOR_PHP_USER" != "root" ] && [ "$SUPERVISOR_PHP_USER" != "sail" ]; then
    echo "You should set SUPERVISOR_PHP_USER to either 'sail' or 'root'."
    exit 1
fi

if [ ! -z "$WWWUSER" ]; then
    usermod -u $WWWUSER sail
fi

if [ ! -d /.composer ]; then
    mkdir /.composer
fi

chmod -R ugo+rw /.composer

# Ensure music storage directory has proper permissions
MUSIC_DIR="/var/www/html/storage/app/public/music"
if [ ! -d "$MUSIC_DIR" ]; then
    echo "Creating music directory: $MUSIC_DIR"
    mkdir -p "$MUSIC_DIR"
fi

echo "Setting proper permissions on music directory"
chown -R sail:sail "$MUSIC_DIR"
chmod -R 775 "$MUSIC_DIR"

if [ $# -gt 0 ]; then
    if [ "$SUPERVISOR_PHP_USER" = "root" ]; then
        exec "$@"
    else
        exec gosu $WWWUSER "$@"
    fi
else
    exec /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.conf
fi
