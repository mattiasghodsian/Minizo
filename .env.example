APP_NAME=Minizo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=CET
APP_URL=http://localhost
APP_REGISTER=false
APP_FORGOTPASS=false
APP_FORCE_HTTPS=false

# --- Integrations ---------------------------------------------------------
# All optional. Without credentials the matching feature reports itself
# unavailable and the rest of the app keeps working.

# Metadata lookup when tagging a file (MusicBrainz + Cover Art Archive).
# Genuinely optional: the API is open, and a token only raises the rate limit.
# Minizo holds itself to one request per second either way.
MUSICBRAINZ_TOKEN=

# MusicBrainz requires an application name and a contact URL, and answers a request
# without one with a 503 that looks exactly like rate limiting. Change the URL if you
# run a fork, so problem reports reach you rather than upstream.
MUSICBRAINZ_USER_AGENT="Minizo (https://github.com/mattiasghodsian/Minizo)"

# TIDAL powers the Feed: artist search and new-release tracking.
# Register an app at https://developer.tidal.com to get these.
# countryCode is required by every catalogue endpoint and also determines which
# releases are visible, since availability is licensed per territory.
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=
TIDAL_COUNTRY=US

# --- Library & downloads --------------------------------------------------
# FLAC compression level for extracted audio: 0 fastest, 12 smallest.
# yt-dlp's --audio-quality does nothing for lossless formats; this is the knob.
MINIZO_FLAC_COMPRESSION_LEVEL=8

# Seconds without progress before a download is treated as wedged and failed.
MINIZO_DOWNLOAD_STALL_TIMEOUT=900

# How long expired or revoked share links are kept for audit before pruning.
MINIZO_SHARE_RETENTION_DAYS=30

# Requests per minute per IP against the public /s/{token} routes. Not a defence
# against guessing the token — it is 71 bits — but against an unauthenticated endpoint
# that streams gigabytes off disk.
MINIZO_SHARE_RATE_LIMIT=60

# Whether public sharing starts enabled on a FRESH install only. Once an admin uses
# the toggle in Settings, the stored value wins and this is ignored — a control the UI
# offers cannot live somewhere that needs a file edit and a restart.
MINIZO_SHARING_ENABLED=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
# Use the compose service name when running inside Docker, 127.0.0.1 otherwise.
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=minizo_laravel
# Must not be "root" — the MariaDB image refuses to start with MYSQL_USER=root.
DB_USERNAME=minizo
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Set to true when you serve Minizo over HTTPS. Without it the session cookie
# is sent over plain HTTP too, which is how a session gets stolen on a shared
# network. Left false by default because a LAN install on http:// would not be
# able to log in at all with it on.
SESSION_SECURE_COOKIE=false

# The address of the reverse proxy in front of Minizo, or * when the container
# is only reachable through one. Until this is set, Laravel sees the proxy as
# the client: every visitor shares one rate-limit bucket, generated URLs come
# out http:// behind TLS, and passkey login fails on an origin mismatch.
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# VITE_ALLOWED_ORIGINS=https://example.com,http://localhost
# VITE_DEV_SERVER_HMR_HOST=localhost